> = 0.0;

uniform float AnisoExponent <
    string UIName   = "Aniso Exponent";
    string UIWidget = "Slider";
    float  UIMin = 1.0; float UIMax = 200.0; float UIStep = 1.0;
    string UIGroup  = "6 - Hair";
    int    UIOrder  = 604;
> = 40.0;


//-----------------------------------------------------------------------------
//  Face  --  GBFR view-driven nose / cheek rim
//    mask: R = right cheek, G = left nose, B = left cheek, A = right nose
//-----------------------------------------------------------------------------
uniform bool UseFaceRim <
    string UIName  = "Enable Face Rim";
    string UIGroup = "7 - Face";
    int    UIOrder = 700;
> = false;

uniform texture2D FaceMask <
    string ResourceName = "";
    string ResourceType = "2D";
    string UIName   = "Face Mask  R=Rcheek G=Lnose B=Lcheek A=Rnose";
    string UIWidget = "FilePicker";
    string UIGroup  = "7 - Face";
    int    UIOrder  = 701;
>;
uniform sampler2D FaceMaskSampler = sampler_state {
    Texture = <FaceMask>;
    TEXTURE_MIN_FILTER = LINEAR;  TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = CLAMP_TO_EDGE;  TEXTURE_WRAP_T = CLAMP_TO_EDGE;
};

uniform vec3 FaceRimColor <
    string UIName   = "Face Rim Color";
    string UIWidget = "ColorPicker";
    string UIGroup  = "7 - Face";
    int    UIOrder  = 702;
> = {1.0, 0.95, 0.92};

uniform float FaceRimIntensity <
    string UIName   = "Face Rim Intensity";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 50.0; float UIStep = 0.5;
    string UIGroup  = "7 - Face";
    int    UIOrder  = 703;
> = 6.0;

// Head basis in world space -- drive from a head joint via the Python tool.
uniform vec3 HeadForward <
    string UIName  = "Head Forward";
    string UIGroup = "7 - Face";
    int    UIOrder = 704;
> = {0.0, 0.0, 1.0};

uniform vec3 HeadRight <
    string UIName  = "Head Right";
    string UIGroup = "7 - Face";
    int    UIOrder = 705;
> = {1.0, 0.0, 0.0};

// Genshin-style SDF face shadow (light driven) -- complements the rim above
uniform bool UseFaceSDF <
    string UIName  = "Enable Face SDF Shadow";
    string UIGroup = "7 - Face";
    int    UIOrder = 706;
> = false;

uniform texture2D FaceSDFMap <
    string ResourceName = "";
    string ResourceType = "2D";
    string UIName   = "Face SDF Map";
    string UIWidget = "FilePicker";
    string UIGroup  = "7 - Face";
    int    UIOrder  = 707;
>;
uniform sampler2D FaceSDFSampler = sampler_state {
    Texture = <FaceSDFMap>;
    TEXTURE_MIN_FILTER = LINEAR;  TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = CLAMP_TO_EDGE;  TEXTURE_WRAP_T = CLAMP_TO_EDGE;
};

uniform float FaceSDFSoftness <
    string UIName   = "Face SDF Softness";
    string UIWidget = "Slider";
    float  UIMin = 0.001; float UIMax = 0.3; float UIStep = 0.005;
    string UIGroup  = "7 - Face";
    int    UIOrder  = 708;
> = 0.02;


