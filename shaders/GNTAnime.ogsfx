//-----------------------------------------------------------------------------
//  Lights  (Maya binds these from the scene)
//-----------------------------------------------------------------------------
// Light parameters must carry UIName *and* Space = "World", exactly the way
// AutodeskUberShader.ogsfx declares them. Leave Space off DIRECTION and Maya
// fails to classify the parameter: `GLSLShader -q -li` reports the light group
// as "undefined", the uniform degrades into a generic matrix attribute, and
// the GLSL receives zeros -- so the scene light contributes nothing at all
// while the Attribute Editor still shows perfectly sensible values.
// Measured before the fix: a sphere read 0% lit from every light angle.

uniform int   Light0Type      : LIGHTTYPE      < string UIName = "Light 0 Type";      string Object = "Light 0"; string UIWidget = "None"; > = 4;
uniform vec3  Light0Color     : LIGHTCOLOR     < string UIName = "Light 0 Color";     string Object = "Light 0"; string UIWidget = "ColorPicker"; > = {1.0, 1.0, 1.0};
uniform float Light0Intensity : LIGHTINTENSITY < string UIName = "Light 0 Intensity"; string Object = "Light 0"; > = 1.0;
uniform vec3  Light0Pos       : POSITION       < string UIName = "Light 0 Position";  string Space = "World"; string Object = "Light 0"; > = {0.0, 100.0, 0.0};
uniform vec3  Light0Dir       : DIRECTION      < string UIName = "Light 0 Direction"; string Space = "World"; string Object = "Light 0"; > = {0.0, -1.0, 0.0};
uniform float Light0Decay     : DECAYRATE      < string UIName = "Light 0 Decay";     string Object = "Light 0"; > = 0.0;
uniform float Light0Cone      : HOTSPOT        < string UIName = "Light 0 Cone";      string Object = "Light 0"; > = 0.46;
uniform float Light0Falloff   : FALLOFF        < string UIName = "Light 0 Penumbra";  string Object = "Light 0"; > = 0.7;

uniform int   Light1Type      : LIGHTTYPE      < string UIName = "Light 1 Type";      string Object = "Light 1"; string UIWidget = "None"; > = 4;
uniform vec3  Light1Color     : LIGHTCOLOR     < string UIName = "Light 1 Color";     string Object = "Light 1"; string UIWidget = "ColorPicker"; > = {1.0, 1.0, 1.0};
uniform float Light1Intensity : LIGHTINTENSITY < string UIName = "Light 1 Intensity"; string Object = "Light 1"; > = 0.0;
uniform vec3  Light1Pos       : POSITION       < string UIName = "Light 1 Position";  string Space = "World"; string Object = "Light 1"; > = {0.0, 100.0, 0.0};
uniform vec3  Light1Dir       : DIRECTION      < string UIName = "Light 1 Direction"; string Space = "World"; string Object = "Light 1"; > = {0.0, -1.0, 0.0};
uniform float Light1Decay     : DECAYRATE      < string UIName = "Light 1 Decay";     string Object = "Light 1"; > = 0.0;
uniform float Light1Cone      : HOTSPOT        < string UIName = "Light 1 Cone";      string Object = "Light 1"; > = 0.46;
uniform float Light1Falloff   : FALLOFF        < string UIName = "Light 1 Penumbra";  string Object = "Light 1"; > = 0.7;

uniform int   Light2Type      : LIGHTTYPE      < string UIName = "Light 2 Type";      string Object = "Light 2"; string UIWidget = "None"; > = 4;
uniform vec3  Light2Color     : LIGHTCOLOR     < string UIName = "Light 2 Color";     string Object = "Light 2"; string UIWidget = "ColorPicker"; > = {1.0, 1.0, 1.0};
uniform float Light2Intensity : LIGHTINTENSITY < string UIName = "Light 2 Intensity"; string Object = "Light 2"; > = 0.0;
uniform vec3  Light2Pos       : POSITION       < string UIName = "Light 2 Position";  string Space = "World"; string Object = "Light 2"; > = {0.0, 100.0, 0.0};
uniform vec3  Light2Dir       : DIRECTION      < string UIName = "Light 2 Direction"; string Space = "World"; string Object = "Light 2"; > = {0.0, -1.0, 0.0};
uniform float Light2Decay     : DECAYRATE      < string UIName = "Light 2 Decay";     string Object = "Light 2"; > = 0.0;
uniform float Light2Cone      : HOTSPOT        < string UIName = "Light 2 Cone";      string Object = "Light 2"; > = 0.46;
uniform float Light2Falloff   : FALLOFF        < string UIName = "Light 2 Penumbra";  string Object = "Light 2"; > = 0.7;

uniform mat4 gShadowVP : ViewProjection < string UIWidget = "None"; >;


//-----------------------------------------------------------------------------
//  Vertex streams / varyings
//-----------------------------------------------------------------------------
attribute APPDATA
{
    vec3 inPosition : POSITION;
    vec3 inNormal   : NORMAL;
    vec3 inTangent  : TANGENT;
    vec3 inBinormal : BINORMAL;
    vec2 inUV0      : TEXCOORD0;
    vec2 inOctNormal : TEXCOORD1;
    vec2 inShadeNormal : TEXCOORD2;
    vec4 inColor0   : COLOR0;
};

attribute SHADERDATA
{
    vec3 wPos;
    vec3 wNormal;
    vec3 wTangent;
    vec3 wBinormal;
    vec2 uv0;
    vec4 vcol;
    vec3 wShadeNormal;
};

attribute OUTLINEDATA
{
    vec3 oPos;
    vec2 uv0;
};

attribute PIXELDATA       { vec4 outColor : COLOR0; };
attribute PIXELDATA_OL    { vec4 outColor : COLOR0; };
attribute PIXELDATA_SHDW  { vec4 outColor : COLOR0; };


//=============================================================================
//  Shared helpers
//=============================================================================
GLSLShader Common
{
    // Maya hands GLSL a flipped V.
    vec2 flipUV(vec2 uv) { return vec2(uv.x, 1.0 - uv.y); }

    float sat(float x) { return clamp(x, 0.0, 1.0); }
    vec3  sat3(vec3 v)  { return clamp(v, 0.0, 1.0); }

    vec3 toLinear(vec3 c) { return pow(max(c, vec3(0.0)), vec3(2.2)); }

    // Resolve light i into a world-space direction (surface -> light),
    // a colour premultiplied by intensity, and a distance attenuation.
    void resolveLight(int   type,
                      vec3  lcolor,
                      float lintensity,
                      vec3  lpos,
                      vec3  ldir,
                      float ldecay,
                      float lcone,
                      float lfalloff,
                      vec3  wpos,
                      out vec3  L,
                      out vec3  radiance,
                      out float isAmbient)
    {
        isAmbient = 0.0;
        float atten = 1.0;

        if (type == 4) {              // directional
            L = normalize(-ldir);
        } else if (type == 5) {       // ambient
            L = vec3(0.0, 1.0, 0.0);
            isAmbient = 1.0;
        } else {                      // point / spot
            vec3 toLight = lpos - wpos;
            float dist   = max(length(toLight), 1e-4);
            L = toLight / dist;

            if (ldecay > 0.0) {
                atten = 1.0 / pow(dist, ldecay);
            }
            if (type == 2) {          // spot cone
                float cosAng = dot(normalize(ldir), -L);
                float inner  = cos(max(lcone - lfalloff, 0.0));
                float outer  = cos(lcone);
                atten *= smoothstep(outer, inner, cosAng);
            }
        }

        radiance = lcolor * lintensity * atten;
    }

    // Diffuse band: half-lambert -> threshold -> ramp texture or two-tone mix.
    vec3 celDiffuse(float ndl, float aoMask, float rampRow, bool useRamp,
                    sampler2D rampSmp, vec3 shadowCol,
                    float threshold, float softness, float halfLambertAmt,
                    out float bandFactor)
    {
        float lambert = mix(sat(ndl), ndl * 0.5 + 0.5, halfLambertAmt);
        float lit     = sat(lambert * aoMask);

        if (useRamp) {
            // Ramp rows are stacked vertically; sample the middle of the row.
            float v = (rampRow + 0.5) / max(RampRows, 1.0);
            bandFactor = lit;
            return texture(rampSmp, flipUV(vec2(lit, v))).rgb;
        }

        float band = smoothstep(threshold - softness, threshold + softness, lit);
        bandFactor = band;
        return mix(shadowCol, vec3(1.0), band);
    }

    // Kajiya-Kay strand highlight.
    float strandSpecular(vec3 T, vec3 H, float exponent)
    {
        float TdotH = dot(T, H);
        float sinTH = sqrt(max(0.0, 1.0 - TdotH * TdotH));
        return pow(sinTH, exponent);
    }

    // Pick one channel out of a packed mask, so a single texture can gate
    // several features at once.
    float pickChannel(vec4 c, float index)
    {
        int i = int(index + 0.5);
        if (i == 1) return c.g;
        if (i == 2) return c.b;
        if (i == 3) return c.a;
        return c.r;
    }

    // Cheap per-vertex randomness, used to make the outline width breathe.
    float hash21(vec2 p)
    {
        p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
        return fract(sin(p.x + p.y + 20.0) * 53758.5453123);
    }

    // Unpack a unit vector from the 2 floats stored in a UV set.
    vec3 octDecode(vec2 f)
    {
        f = f * 2.0 - 1.0;
        vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
        float t = max(-n.z, 0.0);
        n.x += (n.x >= 0.0) ? -t : t;
        n.y += (n.y >= 0.0) ? -t : t;
        return normalize(n);
    }

    // Object-space triplanar sample, used to break the outline up.
    float triplanarNoise(vec3 opos, vec3 onormal, sampler2D smp, float scale)
    {
        vec3 t    = pow(abs(onormal), vec3(2.0));
        vec3 mask = t / max(t.x + t.y + t.z, 1e-4);
        vec3 p    = opos * scale;

        float cz = texture(smp, flipUV(p.xy)).r * mask.z;
        float cy = texture(smp, flipUV(p.xz)).r * mask.y;
        float cx = texture(smp, flipUV(p.yz)).r * mask.x;
        return cx + cy + cz;
    }
}


//=============================================================================
//  Main shading  --  vertex
//=============================================================================
GLSLShader VS_Main
{
    void main()
    {
        vec4 wp = gWorldXf * vec4(inPosition, 1.0);

        VS_OUT.wPos      = wp.xyz;
        VS_OUT.wNormal   = normalize((gWorldIT * vec4(inNormal,   0.0)).xyz);
        VS_OUT.wTangent  = normalize((gWorldXf * vec4(inTangent,  0.0)).xyz);
        VS_OUT.wBinormal = normalize((gWorldXf * vec4(inBinormal, 0.0)).xyz);
        VS_OUT.uv0       = inUV0;
        VS_OUT.vcol      = inColor0;

        // Normal Edit: the baked field is tangent space, so rebuild it here
        // with the same Gram-Schmidt frame the bake used, then take it to
        // world. Done per vertex because that is the resolution it was
        // authored at -- interpolating the result is the point.
        {
            vec3 N = normalize(inNormal);
            vec3 T = inTangent - N * dot(N, inTangent);
            T = (length(T) > 1e-8) ? normalize(T) : normalize(inTangent);
            vec3 B = cross(N, T);
            if (dot(B, inBinormal) < 0.0) B = -B;

            vec3 objShade = mat3(T, B, N) * octDecode(inShadeNormal);
            VS_OUT.wShadeNormal = normalize((gWorldIT * vec4(objShade, 0.0)).xyz);
        }

        gl_Position = gWVPXf * vec4(inPosition, 1.0);
    }
}


//=============================================================================
//  Main shading  --  pixel
//=============================================================================
GLSLShader PS_Main
{
    void main()
    {
        vec2 uv = PS_IN.uv0;

        //---- albedo -------------------------------------------------------
        vec4 albedoTex = vec4(1.0);
        if (UseAlbedoMap) {
            albedoTex = texture(AlbedoSampler, flipUV(uv));
            if (AlbedoIsSRGB) albedoTex.rgb = toLinear(albedoTex.rgb);
        }
        if (UseAlphaClip && albedoTex.a < AlphaCutoff) discard;

        vec3 albedo = albedoTex.rgb * BaseColor;

        //---- ILM mask -----------------------------------------------------
        vec4 ilm = vec4(1.0, 1.0, 0.5, 0.0);
        if (UseLightMap) ilm = texture(LightMapSampler, flipUV(uv));

        float specMask   = UseLightMap ? ilm.r : 1.0;
        float specSize   = UseLightMap ? ilm.b : 0.5;
        float matID      = UseLightMap ? ilm.a : 0.0;

        // Green cannot be both "where the terminator sits" and "how occluded
        // this is". Whichever reading is active, the other is off: the bias
        // below leads, so it silences the occlusion reading rather than the
        // two quietly compounding into a model that is uniformly too dark.
        float aoFromILM = (ILMShadowBias > 0.0) ? 0.0 : ILMAoStrength;

        float ao = 1.0;
        if (UseLightMap) ao *= mix(1.0, ilm.g, aoFromILM);
        if (UseVertexAO) ao *= PS_IN.vcol.g;
        if (UseAOMap) {
            float m = pickChannel(texture(AOSampler, flipUV(uv)), AOChannel);
            ao *= mix(1.0, m, AOStrength);
        }
        ao = sat(ao);

        // The band and the ambient want different amounts of the same AO.
        float aoMask   = mix(1.0, ao, AOAffectsBand);
        float aoAmbient = mix(1.0, ao, AOAffectsAmbient);

        float rampRow = UseMatIDForRamp
                      ? floor(sat(matID) * max(RampRows - 1.0, 0.0) + 0.5)
                      : RampRowIndex;

        //---- basis --------------------------------------------------------
        vec3 Ngeom  = normalize(PS_IN.wNormal);
        vec3 camPos = gViewIXf[3].xyz;
        vec3 V      = normalize(camPos - PS_IN.wPos);

        // N carries the normal-map detail and drives specular, rim and matcap.
        // Nband is the one the cel threshold uses, held back towards the
        // geometric normal so the terminator does not break into speckle.
        vec3 N     = Ngeom;
        vec3 Nband = Ngeom;

        if (UseNormalMap) {
            vec3 raw = texture(NormalSampler, flipUV(uv)).xyz * 2.0 - 1.0;
            if (NormalFlipGreen) raw.y = -raw.y;

            int nspace = int(NormalMapSpace + 0.5);

            if (nspace == 0) {
                // Tangent space: scale the sideways components, then rotate
                // into world through the same Gram-Schmidt frame the outline
                // bake uses, so both agree even when Maya's tangent is not
                // perpendicular to the normal.
                raw.xy *= NormalStrength;
                raw = normalize(raw);

                vec3 T = normalize(PS_IN.wTangent - Ngeom * dot(Ngeom, PS_IN.wTangent));
                vec3 B = cross(Ngeom, T);
                if (dot(B, PS_IN.wBinormal) < 0.0) B = -B;

                N = normalize(mat3(T, B, Ngeom) * raw);
            } else {
                // Object and world space maps already hold a full direction,
                // so there is nothing to rotate into place and no tangent
                // frame involved -- strength becomes a blend against the
                // geometric normal instead of a sideways scale.
                vec3 wn = normalize(raw);
                if (nspace == 1) {
                    wn = normalize((gWorldIT * vec4(wn, 0.0)).xyz);
                }
                N = normalize(mix(Ngeom, wn, clamp(NormalStrength, 0.0, 1.0)));
            }

            Nband = normalize(mix(Ngeom, N, NormalDiffuseAmount));
        }

        // Normal Edit replaces the band normal outright -- that is the whole
        // idea. Everything else on this pixel still uses N.
        if (UseShadeNormal) {
            // A Normal Edit field that arrives pointing past a right angle
            // from the real normal does not soften the shadow, it lights the
            // opposite side.
            //
            // The bake reports its own worst deviation and warns above 90, but
            // that measurement and this one do not see the same thing: the
            // bake compares against face-vertex normals, which on a mesh with
            // flipped faces read wildly (166 degrees on this character's hair)
            // while the vertex-level field is fine (74). What survives to here
            // is whatever the tangent-space round trip produced, and a corrupt
            // basis can invert a value that was correct when written. So the
            // check belongs at the point of use, per pixel, not only at bake
            // time -- refuse the field where it has turned away, keep it
            // everywhere else.
            vec3 sn = normalize(PS_IN.wShadeNormal);
            if (dot(sn, Ngeom) > 0.0)
                Nband = normalize(mix(Nband, sn, ShadeNormalAmount));
        }

        //---- key light ----------------------------------------------------
        int   kType  = Light0Type;
        vec3  kColor = Light0Color;   float kInt = Light0Intensity;
        vec3  kPos   = Light0Pos;     vec3  kDir = Light0Dir;
        float kDecay = Light0Decay;   float kCone = Light0Cone;  float kFall = Light0Falloff;

        if (KeyLightIndex > 1.5) {
            kType = Light2Type; kColor = Light2Color; kInt = Light2Intensity;
            kPos  = Light2Pos;  kDir   = Light2Dir;
            kDecay = Light2Decay; kCone = Light2Cone; kFall = Light2Falloff;
        } else if (KeyLightIndex > 0.5) {
            kType = Light1Type; kColor = Light1Color; kInt = Light1Intensity;
            kPos  = Light1Pos;  kDir   = Light1Dir;
            kDecay = Light1Decay; kCone = Light1Cone; kFall = Light1Falloff;
        }

        vec3  L, keyRadiance;  float keyAmbient;
        resolveLight(kType, kColor, kInt, kPos, kDir, kDecay, kCone, kFall,
                     PS_IN.wPos, L, keyRadiance, keyAmbient);

        if (UseLightOverride) {
            L = normalize(LightDirOverride);
            keyAmbient = 0.0;
            if (kInt <= 0.0) keyRadiance = vec3(1.0);
        }

        float ndl     = dot(N, L);         // detailed -- specular, rim
        float ndlBand = dot(Nband, L);     // held back -- the cel threshold
        vec3  H       = normalize(L + V);

        //---- shadow tint --------------------------------------------------
        // GGXrd: the shadow colour is painted per pixel, not picked globally.
        vec3 shadowTint = ShadowColor;
        if (UseSSSMap) {
            vec3 sss = texture(SSSSampler, flipUV(uv)).rgb;
            if (AlbedoIsSRGB) sss = toLinear(sss);
            shadowTint = mix(ShadowColor, sss, SSSStrength);
        }

        //---- shadow threshold ---------------------------------------------
        // GGXrd paints the terminator position into ILM green.
        float threshold = ShadowThreshold;
        if (UseLightMap && ILMShadowBias > 0.0) {
            float painted = ilm.g;
            if (ILMBiasUseVertexColor) painted *= PS_IN.vcol.r;
            threshold = mix(ShadowThreshold, 1.0 - painted, ILMShadowBias);
        }

        //---- diffuse band -------------------------------------------------
        float bandFactor;
        vec3 band = celDiffuse(ndlBand, aoMask, rampRow, UseRampMap, RampSampler,
                               shadowTint, threshold, ShadowSoftness, HalfLambert,
                               bandFactor);

        //---- face SDF overrides the band on the face ----------------------
        if (UseFaceSDF) {
            vec3 F = normalize(HeadForward);
            vec3 R = normalize(HeadRight);
            vec3 U = normalize(cross(F, R));

            // The map is indexed by where the light sits *around* the head, so
            // it needs the light flattened onto the horizontal plane. Directly
            // overhead there is no such direction: the projection collapses to
            // the zero vector and normalising it yields garbage the shader then
            // reads with total confidence. Measure how much horizontal
            // direction is actually left and fade back to the ordinary band as
            // it runs out -- which is also the honest answer, because a face
            // SDF baked for a light swinging round the head says nothing about
            // one hanging above it.
            vec3  flatL = L - dot(L, U) * U;
            float horiz = length(flatL);
            float sdfWeight = smoothstep(0.15, 0.45, horiz);

            if (sdfWeight > 0.0) {
                vec3  Lh    = flatL / max(horiz, 1e-5);
                float FdotL = dot(F, Lh);
                float RdotL = dot(R, Lh);

                vec2 sdfUV = uv;
                if (FaceSDFMirror && RdotL < 0.0)
                    sdfUV.x = 2.0 * FaceSDFMirrorPivot - uv.x;
                float sdf  = texture(FaceSDFSampler, flipUV(sdfUV)).r;

                float threshold = (1.0 - FdotL) * 0.5;
                float faceLit   = smoothstep(threshold - FaceSDFSoftness,
                                             threshold + FaceSDFSoftness, sdf);
                band       = mix(band, mix(shadowTint, vec3(1.0), faceLit),
                                 sdfWeight);
                bandFactor = mix(bandFactor, faceLit, sdfWeight);
            }
        }

        // Two ways to spend a shadow colour map, and which one is right
        // depends entirely on how it was painted:
        //   Multiply  - the map is a tint over the albedo (Guilty Gear Xrd)
        //   Replace   - the map already IS the finished shadow colour
        // Measured on this character: albedo luminance 0.83, SSS map 0.45. A
        // map that dark is a finished colour, not a tint -- multiplying it
        // drops the shadow to 45% and pushes R/G from 1.22 to 1.70, which
        // reads as a muddy red rather than skin in shade.
        //
        // The ramp gets its own branch because it used to fall into the first
        // one and lose its colour: with a shadow map loaded and Replace
        // selected, celDiffuse's ramp colour was computed and then thrown
        // away. Something still changed on screen -- bandFactor switches from
        // a stepped band to a linear lit, so the falloff shifted -- which made
        // it look like the ramp was working while none of its colours ever
        // reached the pixel. That is the worst kind of wrong: loading a warm
        // skin ramp visibly did *something*, just never what it said.
        //
        // Where both are on, the ramp shapes the falloff and the map tints its
        // dark end, which is the combination that makes sense on skin: the
        // ramp says how the light dies away, the map says what colour the
        // flesh goes while it does.
        vec3 diffuse;
        if (UseRampMap) {
            vec3 tint = mix(vec3(1.0), shadowTint,
                            (1.0 - bandFactor) * sat(ShadowColorMode)
                            * float(UseSSSMap));
            diffuse = albedo * band * tint * keyRadiance;
        } else if (ShadowColorMode > 0.5 && UseSSSMap) {
            diffuse = mix(shadowTint, albedo, bandFactor) * keyRadiance;
        } else {
            diffuse = albedo * band * keyRadiance;
        }

        //---- specular -----------------------------------------------------
        vec3 specTint = SpecColor;
        if (UseSpecColorMap) {
            vec3 sc = texture(SpecColorSampler, flipUV(uv)).rgb;
            if (AlbedoIsSRGB) sc = toLinear(sc);
            specTint = mix(SpecColor, SpecColor * sc, SpecColorMapAmount);
        }

        vec3 specular = vec3(0.0);
        int  smode    = int(SpecMode + 0.5);

        if (smode == 3) {
            // Kajiya-Kay hair
            float shift = 0.0;
            float hairAO = 1.0;
            float hairRamp = 1.0;
            if (UseHairMask) {
                vec4 hm  = texture(HairMaskSampler, flipUV(uv));
                shift    = (hm.r * 2.0 - 1.0) * AnisoShiftIntensity;
                hairRamp = hm.g;
                hairAO   = hm.b;
            }
            vec3  T   = normalize(PS_IN.wBinormal);   // hair strands run along V
            vec3  Ts  = normalize(N * (shift + AnisoBias) + T);
            float s   = strandSpecular(Ts, H, AnisoExponent);
            specular  = specTint * s * SpecIntensity * sat(ndl) * specMask * hairAO;
            diffuse  *= mix(1.0, hairRamp, float(UseHairMask));
        }
        else if (smode == 2) {
            // GBFR: tint the highlight through a ramp
            float raw   = pow(sat(dot(N, H)), SpecGloss);
            float w     = sat(SpecRampWidth);
            float rampU = sat(w * raw - w + 1.0);
            vec3  tint  = texture(SpecRampSampler, flipUV(vec2(rampU, 0.5))).rgb;
            specular    = specTint * tint * raw * SpecIntensity * specMask * sat(ndl);
        }
        else if (smode == 1) {
            // hard cel highlight
            float gloss = mix(SpecGloss * 0.25, SpecGloss * 2.0, specSize);
            float raw   = pow(sat(dot(N, H)), gloss);
            float step_ = smoothstep(SpecThreshold - SpecSoftness,
                                     SpecThreshold + SpecSoftness, raw);
            specular    = specTint * step_ * SpecIntensity * specMask * sat(ndl);
        }
        if (UseSpecMask) {
            float sm = pickChannel(texture(SpecMaskSampler, flipUV(uv)), SpecMaskChannel);
            if (SpecMaskInvert) sm = 1.0 - sm;
            specular *= sm;
        }

        specular *= keyRadiance;

        //---- rim ----------------------------------------------------------
        float fres = pow(1.0 - sat(dot(N, V)), RimPower);

        // Crisp strip rather than a falloff.
        float rimBand = smoothstep(RimThreshold - RimSoftness,
                                   RimThreshold + RimSoftness, fres);

        float upMask = mix(1.0, sat(dot(N, vec3(0.0, 1.0, 0.0))), RimUpMask);

        // Which SIDE of the silhouette the light is on cannot be answered by
        // dot(N, L): along the rim N is perpendicular to V, so that dot sits
        // near zero on both sides and the rim wraps the whole outline. Project
        // both vectors onto the screen plane first and the two sides separate
        // cleanly.
        vec3  Nv = N - V * dot(N, V);
        vec3  Lv = L - V * dot(L, V);
        float side = (length(Nv) > 1e-4 && length(Lv) > 1e-4)
                   ? sat(dot(normalize(Nv), normalize(Lv)))
                   : 1.0;
        float sideMask = mix(1.0, side, RimFollowLight);

        vec3 rim = RimColor * rimBand * upMask * sideMask * RimIntensity;

        if (UseRimMask) {
            float rm = pickChannel(texture(RimMaskSampler, flipUV(uv)), RimMaskChannel);
            if (RimMaskInvert) rm = 1.0 - rm;
            rim *= rm;
        }

        //---- GBFR face rim (camera driven) --------------------------------
        vec3 faceRim = vec3(0.0);
        if (UseFaceRim) {
            vec3 Vh = normalize(vec3(V.x, 0.0, V.z));
            vec3 F  = normalize(HeadForward);
            vec3 R  = normalize(HeadRight);

            float VdotF  = sat(dot(Vh, F));
            float side   = (dot(Vh, R) < 0.0) ? 0.0 : 1.0;
            float turned = 1.0 - VdotF;

            vec4 fm = texture(FaceMaskSampler, flipUV(uv));
            // strip stray low values the way GBFR does
            float rC = fm.r > 0.005 ? fm.r : 0.0;   // right cheek
            float lN = fm.g > 0.005 ? fm.g : 0.0;   // left nose
            float lC = fm.b > 0.005 ? fm.b : 0.0;   // left cheek
            float rN = fm.a > 0.005 ? fm.a : 0.0;   // right nose

            float nose  = lN * turned * side + rN * turned * (1.0 - side);
            float cheek = lC * turned * side + rC * turned * (1.0 - side);
            faceRim = FaceRimColor * (nose + cheek) * FaceRimIntensity;
        }

        //---- fill lights --------------------------------------------------
        vec3 fill = vec3(0.0);
        for (int i = 1; i < 3; ++i) {
            int   fType;  vec3 fColor;  float fInt;
            vec3  fPos;   vec3 fDir;    float fDecay, fCone, fFall;

            if (i == 1) {
                fType = Light1Type; fColor = Light1Color; fInt = Light1Intensity;
                fPos  = Light1Pos;  fDir   = Light1Dir;
                fDecay = Light1Decay; fCone = Light1Cone; fFall = Light1Falloff;
            } else {
                fType = Light2Type; fColor = Light2Color; fInt = Light2Intensity;
                fPos  = Light2Pos;  fDir   = Light2Dir;
                fDecay = Light2Decay; fCone = Light2Cone; fFall = Light2Falloff;
            }
            if (abs(float(i) - KeyLightIndex) < 0.5) continue;
            if (fInt <= 0.0) continue;

            vec3 fL, fRad;  float fAmb;
            resolveLight(fType, fColor, fInt, fPos, fDir, fDecay, fCone, fFall,
                         PS_IN.wPos, fL, fRad, fAmb);

            fill += (fAmb > 0.5) ? fRad : fRad * sat(dot(N, fL));
        }
        fill *= albedo * FillLightScale * aoAmbient;

        //---- matcap -------------------------------------------------------
        vec3 matcap = vec3(0.0);
        if (UseMatCap) {
            vec3 vN = normalize((gViewXf * vec4(N, 0.0)).xyz);
            vec2 mcUV = vN.xy * 0.5 + 0.5;
            matcap = texture(MatCapSampler, flipUV(mcUV)).rgb * MatCapIntensity;
        }

        //---- emission -----------------------------------------------------
        vec3 emission = vec3(0.0);
        if (UseEmissionMap) {
            emission = texture(EmissionSampler, flipUV(uv)).rgb;
        } else if (EmissionFromAlbedoAlpha) {
            emission = albedo * albedoTex.a;
        }
        emission *= EmissionColor * EmissionIntensity;

        //---- combine ------------------------------------------------------
        vec3 color = diffuse
                   + specular
                   + rim * mix(vec3(1.0), albedo, RimAlbedoTint)
                   + faceRim
                   + fill
                   + matcap * albedo
                   + emission
                   + albedo * AmbientColor * aoAmbient;

        //---- interior lines -----------------------------------------------
        // Last, so the ink sits on top of every lighting term -- a line that
        // brightens with the key light stops reading as ink.
        if (UseInteriorLines && UseLightMap) {
            float mask = InteriorLineInvert ? (1.0 - ilm.a) : ilm.a;
            float line = smoothstep(InteriorLineThreshold - InteriorLineSoftness,
                                    InteriorLineThreshold + InteriorLineSoftness,
                                    mask);
            color = mix(color, InteriorLineColor,
                        (1.0 - line) * InteriorLineOpacity);
        }

        outColor = vec4(color, 1.0);
    }
}


//=============================================================================
//  Outline  --  inverted hull
//=============================================================================
GLSLShader VS_Outline
{
    void main()
    {
        vec3 nrm = inNormal;

        // Baked smooth normal arrives octahedral-encoded in the 2nd UV set,
        // expressed in tangent space so it survives skinning.
        if (OutlineUseSmoothNormal) {
            // Gram-Schmidt, matching orthonormal_basis() in utils/mesh.py.
            // The bake writes the vector with dot products (transpose) and we
            // read it back with a matrix multiply; those only agree when the
            // basis is orthonormal, and Maya's UV-derived tangent is not.
            vec3 N = normalize(inNormal);

            vec3 T = inTangent - N * dot(N, inTangent);
            if (length(T) < 1e-8) {
                T = vec3(1.0, 0.0, 0.0) - N * dot(N, vec3(1.0, 0.0, 0.0));
                if (length(T) < 1e-8) {
                    T = vec3(0.0, 1.0, 0.0) - N * dot(N, vec3(0.0, 1.0, 0.0));
                }
            }
            T = normalize(T);

            vec3 B = cross(N, T);
            if (dot(B, inBinormal) < 0.0) B = -B;

            nrm = normalize(mat3(T, B, N) * octDecode(inOctNormal));
        }

        vec4 wp = gWorldXf * vec4(inPosition, 1.0);
        vec3 wN = normalize((gWorldIT * vec4(nrm, 0.0)).xyz);

        float width = OutlineWidth * 0.01;
        if (OutlineUseVertexColor) width *= inColor0.r;

        // Jitter the width per vertex so the line reads as inked, not vector.
        if (OutlineWidthVariation > 0.0) {
            float jitter = hash21(inPosition.xy * inPosition.yz);
            width *= mix(1.0, jitter, OutlineWidthVariation);
        }

        // Keep the line a constant thickness on screen.
        if (OutlineScreenSpace) {
            float dist = length(gViewIXf[3].xyz - wp.xyz);
            width *= dist;
        }
        // Optional extra falloff so distant characters lose their outline.
        if (OutlineDistanceFade > 0.0) {
            float dist = length(gViewIXf[3].xyz - wp.xyz);
            width *= 1.0 - smoothstep(0.0, OutlineDistanceFade, dist);
        }

        wp.xyz += wN * width;

        vec4 cp = gVPXf * wp;
        // Positive pushes the hull AWAY from the camera, so where it grazes
        // the real surface the surface wins the depth test instead of leaking
        // outline colour through. Negative pulls it forward, for an outline
        // that always draws on top.
        //
        // Measured on a cube probe: 0 leaves 69 stray outline pixels inside
        // the silhouette, 2 removes all of them and costs the ring nothing.
        // Anything beyond that is wasted.
        cp.z   += OutlineZOffset * 1e-4 * cp.w;

        VS_OUT.oPos = inPosition;
        VS_OUT.uv0  = inUV0;

        gl_Position = cp;
    }
}

GLSLShader PS_Outline
{
    void main()
    {
        // OGSFX cannot set "Cull Front", so drop front faces here instead.
        if (gl_FrontFacing) discard;

        // Painted-out stretches of line leave before anything else is done.
        if (UseOutlineMask) {
            float om = pickChannel(texture(OutlineMaskSampler, flipUV(PS_IN.uv0)),
                                   OutlineMaskChannel);
            if (OutlineMaskInvert) om = 1.0 - om;
            if (om < OutlineMaskThreshold) discard;
        }

        vec3 col = OutlineColor;

        // GGXrd tints the line with albedo *and* the SSS map, which is what
        // stops it reading as a flat black vector stroke.
        if (OutlineTintFromAlbedo) {
            vec3 tint = vec3(1.0);
            if (UseAlbedoMap) {
                vec3 a = texture(AlbedoSampler, flipUV(PS_IN.uv0)).rgb;
                if (AlbedoIsSRGB) a = toLinear(a);
                tint *= a;
            }
            if (UseSSSMap) {
                vec3 s = texture(SSSSampler, flipUV(PS_IN.uv0)).rgb;
                if (AlbedoIsSRGB) s = toLinear(s);
                tint *= s;
            }
            col = mix(col, col * tint, OutlineTintAmount);
        }

        if (UseOutlineNoise) {
            // Reconstructing the object normal from derivatives keeps the
            // outline varyings small.
            vec3 n = normalize(cross(dFdx(PS_IN.oPos), dFdy(PS_IN.oPos)));
            float noise = triplanarNoise(PS_IN.oPos, n, OutlineNoiseSampler, OutlineNoiseScale);
            if (noise - OutlineNoiseCutoff < 0.0) discard;
        }

        outColor = vec4(col, 1.0);
    }
}


//=============================================================================
//  Shadow pass
//=============================================================================
GLSLShader PS_Shadow
{
    void main()
    {
        vec4  sp    = gShadowVP * vec4(PS_IN.wPos, 1.0);
        float d     = sp.z / sp.w;
        float depth = 0.5 * (d + fwidth(d)) + 0.5;
        outColor    = vec4(depth);
    }
}


//=============================================================================
//  Techniques
//=============================================================================

// Shading only. Use this if multi-pass outline misbehaves on your GPU.
technique Anime
<
    string variableNameAsAttributeName = "true";
>
{
    pass pShade < string drawContext = "colorPass"; >
    {
        VertexShader (in APPDATA, out SHADERDATA VS_OUT) = { Common, VS_Main };
        PixelShader  (in SHADERDATA PS_IN, out PIXELDATA) = { Common, PS_Main };
    }
    pass pShadow < string drawContext = "shadowPass"; >
    {
        VertexShader (in APPDATA, out SHADERDATA VS_OUT) = { Common, VS_Main };
        PixelShader  (in SHADERDATA PS_IN, out PIXELDATA_SHDW) = { Common, PS_Shadow };
    }
}

// Shading + inverted-hull outline.
technique AnimeOutline
<
    string variableNameAsAttributeName = "true";
>
{
    pass pShade < string drawContext = "colorPass"; >
    {
        VertexShader (in APPDATA, out SHADERDATA VS_OUT) = { Common, VS_Main };
        PixelShader  (in SHADERDATA PS_IN, out PIXELDATA) = { Common, PS_Main };
    }
    pass pOutline < string drawContext = "colorPass"; >
    {
        VertexShader (in APPDATA, out OUTLINEDATA VS_OUT) = { Common, VS_Outline };
        PixelShader  (in OUTLINEDATA PS_IN, out PIXELDATA_OL) = { Common, PS_Outline };
    }
    pass pShadow < string drawContext = "shadowPass"; >
    {
        VertexShader (in APPDATA, out SHADERDATA VS_OUT) = { Common, VS_Main };
        PixelShader  (in SHADERDATA PS_IN, out PIXELDATA_SHDW) = { Common, PS_Shadow };
    }
}
