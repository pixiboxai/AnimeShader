    Texture = <OutlineNoiseMap>;
    TEXTURE_MIN_FILTER = LINEAR;  TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = REPEAT;      TEXTURE_WRAP_T = REPEAT;
};

