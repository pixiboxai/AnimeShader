#version 410

//=============================================================================
//  GNTAnime.ogsfx  --  Anime / cel shader for Maya Viewport 2.0
//
//  Load with the "glslShader" plugin.
//
//  Techniques
//    Anime         : shading only (safest -- always renders)
//    AnimeOutline  : shading + inverted-hull outline pass
//
//  Vertex streams expected
//    COLOR0    : artist paint  R = outline width mult, G = AO, B/A = spare
//    TEXCOORD1 : baked data    octahedral-encoded tangent-space smooth normal
//                -> bake with gntshader.utils.mesh.bake_smooth_normals()
//    Missing streams degrade gracefully (Maya supplies defaults).
//
//  Why TEXCOORD1 and not COLOR1: Maya's glslShader binds exactly one colour
//  stream. Declaring COLOR1 compiles, but the varying is silently dropped --
//  confirmed by `GLSLShader -q -varyingParameters` returning only Color0.
//  A unit vector octahedral-encodes into 2 floats, which fits a UV set exactly.
//
//  Notes
//    - Maya flips V when sampling in GLSL. Always go through flipUV().
//    - OGSFX has no render-state block, so the outline pass culls front faces
//      in the pixel shader via gl_FrontFacing instead of "Cull Front".
//=============================================================================


//-----------------------------------------------------------------------------
//  System matrices
//-----------------------------------------------------------------------------
uniform mat4 gWVPXf   : WorldViewProjection < string UIWidget = "None"; >;
uniform mat4 gWorldXf : World               < string UIWidget = "None"; >;
uniform mat4 gWorldIT : WorldInverseTranspose < string UIWidget = "None"; >;
uniform mat4 gViewIXf : ViewInverse         < string UIWidget = "None"; >;
uniform mat4 gVPXf    : ViewProjection      < string UIWidget = "None"; >;
uniform mat4 gViewXf  : View                < string UIWidget = "None"; >;


//-----------------------------------------------------------------------------
//  Base
//-----------------------------------------------------------------------------
uniform vec3 BaseColor <
    string UIName   = "Base Color";
    string UIWidget = "ColorPicker";
    string UIGroup  = "1 - Base";
    int    UIOrder  = 100;
> = {1.0, 1.0, 1.0};

uniform texture2D AlbedoMap <
    string ResourceName = "";
    string ResourceType = "2D";
    string UIName   = "Albedo Map";
    string UIWidget = "FilePicker";
    string UIGroup  = "1 - Base";
    int    UIOrder  = 101;
>;
uniform sampler2D AlbedoSampler = sampler_state {
    Texture = <AlbedoMap>;
    TEXTURE_MIN_FILTER = LINEAR;  TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = REPEAT;      TEXTURE_WRAP_T = REPEAT;
};

uniform bool UseAlbedoMap <
    string UIName  = "Use Albedo Map";
    string UIGroup = "1 - Base";
    int    UIOrder = 102;
> = false;

uniform bool AlbedoIsSRGB <
    string UIName  = "Albedo Is sRGB";
    string UIGroup = "1 - Base";
    int    UIOrder = 103;
> = true;

//-----------------------------------------------------------------------------
//  1b - Normal map
//
//  Cel shading and normal maps fight each other: the diffuse band is a hard
//  threshold, so perturbing the normal shatters the terminator into speckle.
//  Genshin and GGXrd mostly keep the band on the geometric normal and let the
//  map drive the highlight instead. NormalDiffuseAmount is that dial -- 0
//  keeps the terminator clean, 1 lets the map cut into it.
//-----------------------------------------------------------------------------
uniform texture2D NormalMap <
    string ResourceName = "";
    string ResourceType = "2D";
    string UIName   = "Normal Map";
    string UIWidget = "FilePicker";
    string UIGroup  = "1b - Normal";
    int    UIOrder  = 150;
>;
uniform sampler2D NormalSampler = sampler_state {
    Texture = <NormalMap>;
    TEXTURE_MIN_FILTER = LINEAR;  TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = REPEAT;      TEXTURE_WRAP_T = REPEAT;
};

uniform bool UseNormalMap <
    string UIName  = "Use Normal Map";
    string UIGroup = "1b - Normal";
    int    UIOrder = 151;
> = false;

uniform float NormalStrength <
    string UIName   = "Normal Strength";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 3.0; float UIStep = 0.01;
    string UIGroup  = "1b - Normal";
    int    UIOrder  = 152;
> = 1.0;

// Tangent-space maps follow the surface and survive deformation, which is why
// they are the default for skinned characters. Object and world space maps
// hold an absolute direction: cheaper (no tangent frame) and immune to bad
// UV seams, but they are baked against one pose -- rotate the object and a
// world-space map lights wrongly; skin it and both break.
uniform float NormalMapSpace <
    string UIName   = "Normal Space  0=Tangent 1=Object 2=World";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 2.0; float UIStep = 1.0;
    string UIGroup  = "1b - Normal";
    int    UIOrder  = 153;
> = 0.0;

// Maya, Substance and most DCC bakes are OpenGL (+Y up). Unreal and a lot of
// game bakes are DirectX (-Y). Getting this wrong inverts every dent.
// Only meaningful for tangent-space maps.
uniform bool NormalFlipGreen <
    string UIName  = "Flip Green (DirectX map)";
    string UIGroup = "1b - Normal";
    int    UIOrder = 154;
> = false;

uniform float NormalDiffuseAmount <
    string UIName   = "Affects Cel Band";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "1b - Normal";
    int    UIOrder  = 155;
> = 0.25;

uniform bool UseAlphaClip <
    string UIName  = "Alpha Clip";
    string UIGroup = "1 - Base";
    int    UIOrder = 104;
> = false;

uniform float AlphaCutoff <
    string UIName   = "Alpha Cutoff";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "1 - Base";
    int    UIOrder  = 105;
> = 0.5;


//-----------------------------------------------------------------------------
//  Cel shading
//-----------------------------------------------------------------------------
uniform texture2D RampMap <
    string ResourceName = "";
    string ResourceType = "2D";
    string UIName   = "Diffuse Ramp";
    string UIWidget = "FilePicker";
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 200;
>;
uniform sampler2D RampSampler = sampler_state {
    Texture = <RampMap>;
    TEXTURE_MIN_FILTER = LINEAR;  TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = CLAMP_TO_EDGE;  TEXTURE_WRAP_T = CLAMP_TO_EDGE;
};

uniform bool UseRampMap <
    string UIName  = "Use Diffuse Ramp";
    string UIGroup = "2 - Shading";
    int    UIOrder = 201;
> = false;

uniform float RampRows <
    string UIName   = "Ramp Row Count";
    string UIWidget = "Slider";
    float  UIMin = 1.0; float UIMax = 16.0; float UIStep = 1.0;
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 202;
> = 1.0;

uniform float RampRowIndex <
    string UIName   = "Ramp Row (manual)";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 15.0; float UIStep = 1.0;
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 203;
> = 0.0;

uniform vec3 ShadowColor <
    string UIName   = "Shadow Color";
    string UIWidget = "ColorPicker";
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 204;
> = {0.55, 0.52, 0.65};

uniform float ShadowThreshold <
    string UIName   = "Shadow Threshold";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 208;
> = 0.5;

uniform float ShadowSoftness <
    string UIName   = "Shadow Softness";
    string UIWidget = "Slider";
    float  UIMin = 0.001; float UIMax = 0.5; float UIStep = 0.005;
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 209;
> = 0.03;

uniform float HalfLambert <
    string UIName   = "Half Lambert";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 210;
> = 1.0;

uniform vec3 AmbientColor <
    string UIName   = "Ambient Color";
    string UIWidget = "ColorPicker";
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 211;
> = {0.18, 0.18, 0.22};

uniform float FillLightScale <
    string UIName   = "Fill Light Scale";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 2.0; float UIStep = 0.05;
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 212;
> = 0.35;


//-----------------------------------------------------------------------------
//  2b - Normal Edit  (Arc System Works)
//
//  "In order to get 2D-like shadows, Guilty Gear copy normals from a
//  simplified model." The real normals track every muscle, so the terminator
//  breaks into small busy shapes. A simplified normal field throws the shadow
//  in a few big forms instead, which is what reads as hand-drawn.
//
//  Only the cel band uses this. Specular, rim and the outline keep the real
//  normals, so the silhouette and highlights stay crisp.
//
//  Bake with gntshader.utils.mesh.bake_shade_normals(mesh, source=None).
//-----------------------------------------------------------------------------
uniform bool UseShadeNormal <
    string UIName  = "Use Normal Edit";
    string UIGroup = "2b - Normal Edit";
    int    UIOrder = 250;
> = false;

uniform float ShadeNormalAmount <
    string UIName   = "Normal Edit Amount";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "2b - Normal Edit";
    int    UIOrder  = 251;
> = 1.0;


//-----------------------------------------------------------------------------
//  Light direction override  (art-directed key light)
//-----------------------------------------------------------------------------
uniform bool UseLightOverride <
    string UIName  = "Override Key Light";
    string UIGroup = "3 - Key Light";
    int    UIOrder = 300;
> = false;

uniform vec3 LightDirOverride <
    string UIName   = "Key Light Direction";
    string UIGroup  = "3 - Key Light";
    int    UIOrder  = 301;
> = {-0.4, 0.6, 0.7};

uniform float KeyLightIndex <
    string UIName   = "Key Light Index";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 2.0; float UIStep = 1.0;
    string UIGroup  = "3 - Key Light";
    int    UIOrder  = 302;
> = 0.0;


//-----------------------------------------------------------------------------
//  ILM / lightmap  (Genshin-style packed mask)
//    R = specular intensity, G = shadow offset / AO, B = specular size, A = material ID
//-----------------------------------------------------------------------------
uniform texture2D LightMap <
    string ResourceName = "";
    string ResourceType = "2D";
    string UIName   = "ILM / Light Map";
    string UIWidget = "FilePicker";
    string UIGroup  = "4 - ILM Mask";
    int    UIOrder  = 400;
>;
uniform sampler2D LightMapSampler = sampler_state {
    Texture = <LightMap>;
    TEXTURE_MIN_FILTER = LINEAR;  TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = REPEAT;      TEXTURE_WRAP_T = REPEAT;
};

uniform bool UseLightMap <
    string UIName  = "Use ILM Map";
    string UIGroup = "4 - ILM Mask";
    int    UIOrder = 401;
> = false;

//  Interior lines -- the ILM alpha channel (Arc System Works' own breakdown).
//
//  A silhouette outline alone always reads as empty: GGXrd draws the line work
//  *inside* the shape from a painted mask, and that is most of what sells the
//  ink look. Their note on authoring it: stretch the UVs along each line so it
//  does not stair-step across texels.
uniform bool UseInteriorLines <
    string UIName  = "Interior Lines (ILM alpha)";
    string UIGroup = "4 - ILM Mask";
    int    UIOrder = 410;
> = false;

uniform vec3 InteriorLineColor <
    string UIName   = "Interior Line Color";
    string UIWidget = "ColorPicker";
    string UIGroup  = "4 - ILM Mask";
    int    UIOrder  = 411;
> = {0.08, 0.05, 0.07};

uniform float InteriorLineThreshold <
    string UIName   = "Interior Line Threshold";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "4 - ILM Mask";
    int    UIOrder  = 412;
> = 0.90;

uniform float InteriorLineSoftness <
    string UIName   = "Interior Line Softness";
    string UIWidget = "Slider";
    float  UIMin = 0.001; float UIMax = 0.4; float UIStep = 0.005;
    string UIGroup  = "4 - ILM Mask";
    int    UIOrder  = 413;
> = 0.02;

// Authoring conventions differ: Arc System Works paint the lines dark on a
// white field, plenty of artists do the reverse. Rather than demand a repaint,
// flip it here.
uniform bool InteriorLineInvert <
    string UIName  = "Lines Are White On Black";
    string UIGroup = "4 - ILM Mask";
    int    UIOrder = 415;
> = false;

uniform float InteriorLineOpacity <
    string UIName   = "Interior Line Opacity";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "4 - ILM Mask";
    int    UIOrder  = 414;
> = 1.0;

uniform bool UseMatIDForRamp <
    string UIName  = "Material ID Picks Ramp Row";
    string UIGroup = "4 - ILM Mask";
    int    UIOrder = 402;
> = false;

// Green is a *threshold* map on every Arc System Works ILM: 0.5 means "put the
// terminator wherever the light puts it", brighter means "stay lit", darker
// means "stay in shadow". It is not occlusion, and multiplying it into AO is
// the single easiest mistake to make with this shader -- it was made twice on
// this project, on two different characters, and both times it darkened the
// whole model by about a third (the neutral value being 0.5) while throwing
// away every shadow shape the artist had painted.
//
// So the default is off, ILMShadowBias below is on, and if the bias is doing
// its job this one is ignored outright. Turn it up only for a map you know was
// authored with occlusion in green.
uniform float ILMAoStrength <
    string UIName   = "ILM G as Occlusion (not the usual meaning)";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "4 - ILM Mask";
    int    UIOrder  = 403;
> = 0.0;

uniform bool UseVertexAO <
    string UIName  = "AO From Vertex Color G";
    string UIGroup = "4 - ILM Mask";
    int    UIOrder = 404;
> = false;

// The artist decides where the terminator sits, per pixel, modulated by vertex
// colour red. This is what ILM green is for, so it leads.
uniform float ILMShadowBias <
    string UIName   = "ILM G Drives Shadow Threshold";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "4 - ILM Mask";
    int    UIOrder  = 405;
> = 1.0;

uniform bool ILMBiasUseVertexColor <
    string UIName  = "Threshold x Vertex Color R";
    string UIGroup = "4 - ILM Mask";
    int    UIOrder = 406;
> = false;


//-----------------------------------------------------------------------------
//  Shadow colour map  --  per-pixel shadow tint (GGXrd calls this the SSS map)
//
//  A single ShadowColor drags every material into the same hue. GGXrd paints
//  the shadow colour into its own map instead, so skin goes warm and cloth
//  goes cool inside the same shadow. Lives next to ShadowColor in the UI
//  because that is the value it replaces.
//-----------------------------------------------------------------------------
uniform texture2D SSSMap <
    string ResourceName = "";
    string ResourceType = "2D";
    string UIName   = "Shadow Color Map";
    string UIWidget = "FilePicker";
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 208;
>;
uniform sampler2D SSSSampler = sampler_state {
    Texture = <SSSMap>;
    TEXTURE_MIN_FILTER = LINEAR;  TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = REPEAT;      TEXTURE_WRAP_T = REPEAT;
};

uniform bool UseSSSMap <
    string UIName  = "Use Shadow Color Map";
    string UIGroup = "2 - Shading";
    int    UIOrder = 206;
> = false;

uniform float ShadowColorMode <
    string UIName   = "Shadow Map Mode  0=Multiply 1=Replace";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 1.0;
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 207;
> = 0.0;

uniform float SSSStrength <
    string UIName   = "Shadow Map Blend";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 210;
> = 1.0;


//-----------------------------------------------------------------------------
//  4c - Ambient occlusion
//
//  Arc System Works hand-paint AO into the vertex colours "to correct the
//  shadows". Two jobs hide behind that one word, and they want separate dials:
//
//    Band    - AO pushes a crevice past the cel threshold, so it falls into
//              the shadow band even when the light says otherwise.
//    Ambient - AO darkens the ambient and fill light. Without this the fill
//              floods every crevice and the form goes flat, which is what a
//              cel shader with no AO on its ambient always looks like.
//
//  Sources stack: ILM green, vertex colour green, and this map.
//-----------------------------------------------------------------------------
uniform texture2D AOMap <
    string ResourceName = "";
    string ResourceType = "2D";
    string UIName   = "AO Map";
    string UIWidget = "FilePicker";
    string UIGroup  = "4c - AO";
    int    UIOrder  = 470;
>;
uniform sampler2D AOSampler = sampler_state {
    Texture = <AOMap>;
    TEXTURE_MIN_FILTER = LINEAR;  TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = REPEAT;      TEXTURE_WRAP_T = REPEAT;
};

uniform bool UseAOMap <
    string UIName  = "Use AO Map";
    string UIGroup = "4c - AO";
    int    UIOrder = 471;
> = false;

uniform float AOChannel <
    string UIName   = "AO Channel  0=R 1=G 2=B 3=A";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 3.0; float UIStep = 1.0;
    string UIGroup  = "4c - AO";
    int    UIOrder  = 472;
> = 0.0;

uniform float AOStrength <
    string UIName   = "AO Map Strength";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "4c - AO";
    int    UIOrder  = 473;
> = 1.0;

uniform float AOAffectsBand <
    string UIName   = "AO Into Cel Band";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "4c - AO";
    int    UIOrder  = 474;
> = 1.0;

uniform float AOAffectsAmbient <
    string UIName   = "AO On Ambient / Fill";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "4c - AO";
    int    UIOrder  = 475;
> = 1.0;


//-----------------------------------------------------------------------------
