#version 410

//=============================================================================
//  GNTAnime.ogsfx  --  Anime / cel shader for Maya Viewport 2.0
//
//  Load with the "glslShader" plugin.
//
//  Techniques
//    Anime         : shading only (safest -- always renders)
//    AnimeOutline  : shading + inverted-hull outline pass
//
//  Vertex streams expected
//    COLOR0    : artist paint  R = outline width mult, G = AO, B/A = spare
//    TEXCOORD1 : baked data    octahedral-encoded tangent-space smooth normal
//                -> bake with gntshader.utils.mesh.bake_smooth_normals()
//    Missing streams degrade gracefully (Maya supplies defaults).
//
//  Why TEXCOORD1 and not COLOR1: Maya's glslShader binds exactly one colour
//  stream. Declaring COLOR1 compiles, but the varying is silently dropped --
//  confirmed by `GLSLShader -q -varyingParameters` returning only Color0.
//  A unit vector octahedral-encodes into 2 floats, which fits a UV set exactly.
//
//  Notes
//    - Maya flips V when sampling in GLSL. Always go through flipUV().
//    - OGSFX has no render-state block, so the outline pass culls front faces
//      in the pixel shader via gl_FrontFacing instead of "Cull Front".
//=============================================================================


//-----------------------------------------------------------------------------
//  System matrices
//-----------------------------------------------------------------------------
uniform mat4 gWVPXf   : WorldViewProjection < string UIWidget = "None"; >;
uniform mat4 gWorldXf : World               < string UIWidget = "None"; >;
uniform mat4 gWorldIT : WorldInverseTranspose < string UIWidget = "None"; >;
uniform mat4 gViewIXf : ViewInverse         < string UIWidget = "None"; >;
uniform mat4 gVPXf    : ViewProjection      < string UIWidget = "None"; >;
uniform mat4 gViewXf  : View                < string UIWidget = "None"; >;
uniform vec2 gScreen  : ViewportPixelSize   < string UIWidget = "None"; >;


//-----------------------------------------------------------------------------
//  Base
//-----------------------------------------------------------------------------
uniform vec3 BaseColor <
    string UIName   = "Base Color";
    string UIWidget = "ColorPicker";
    string UIGroup  = "1 - Base";
    int    UIOrder  = 100;
> = {1.0, 1.0, 1.0};

uniform texture2D AlbedoMap <
    string ResourceName = "";
    string ResourceType = "2D";
    string UIName   = "Albedo Map";
    string UIWidget = "FilePicker";
    string UIGroup  = "1 - Base";
    int    UIOrder  = 101;
>;
uniform sampler2D AlbedoSampler = sampler_state {
    Texture = <AlbedoMap>;
    TEXTURE_MIN_FILTER = LINEAR;  TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = REPEAT;      TEXTURE_WRAP_T = REPEAT;
};

uniform bool UseAlbedoMap <
    string UIName  = "Use Albedo Map";
    string UIGroup = "1 - Base";
    int    UIOrder = 102;
> = false;

uniform bool AlbedoIsSRGB <
    string UIName  = "Albedo Is sRGB";
    string UIGroup = "1 - Base";
    int    UIOrder = 103;
> = true;

uniform bool UseAlphaClip <
    string UIName  = "Alpha Clip";
    string UIGroup = "1 - Base";
    int    UIOrder = 104;
> = false;

uniform float AlphaCutoff <
    string UIName   = "Alpha Cutoff";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "1 - Base";
    int    UIOrder  = 105;
> = 0.5;


//-----------------------------------------------------------------------------
//  Cel shading
//-----------------------------------------------------------------------------
uniform texture2D RampMap <
    string ResourceName = "";
    string ResourceType = "2D";
    string UIName   = "Diffuse Ramp";
    string UIWidget = "FilePicker";
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 200;
>;
uniform sampler2D RampSampler = sampler_state {
    Texture = <RampMap>;
    TEXTURE_MIN_FILTER = LINEAR;  TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = CLAMP_TO_EDGE;  TEXTURE_WRAP_T = CLAMP_TO_EDGE;
};

uniform bool UseRampMap <
    string UIName  = "Use Diffuse Ramp";
    string UIGroup = "2 - Shading";
    int    UIOrder = 201;
> = false;

uniform float RampRows <
    string UIName   = "Ramp Row Count";
    string UIWidget = "Slider";
    float  UIMin = 1.0; float UIMax = 16.0; float UIStep = 1.0;
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 202;
> = 1.0;

uniform float RampRowIndex <
    string UIName   = "Ramp Row (manual)";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 15.0; float UIStep = 1.0;
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 203;
> = 0.0;

uniform vec3 ShadowColor <
    string UIName   = "Shadow Color";
    string UIWidget = "ColorPicker";
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 204;
> = {0.55, 0.52, 0.65};

uniform float ShadowThreshold <
    string UIName   = "Shadow Threshold";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 205;
> = 0.5;

uniform float ShadowSoftness <
    string UIName   = "Shadow Softness";
    string UIWidget = "Slider";
    float  UIMin = 0.001; float UIMax = 0.5; float UIStep = 0.005;
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 206;
> = 0.03;

uniform float HalfLambert <
    string UIName   = "Half Lambert";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 207;
> = 1.0;

uniform vec3 AmbientColor <
    string UIName   = "Ambient Color";
    string UIWidget = "ColorPicker";
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 208;
> = {0.18, 0.18, 0.22};

uniform float FillLightScale <
    string UIName   = "Fill Light Scale";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 2.0; float UIStep = 0.05;
    string UIGroup  = "2 - Shading";
    int    UIOrder  = 209;
> = 0.35;


//-----------------------------------------------------------------------------
//  Light direction override  (art-directed key light)
//-----------------------------------------------------------------------------
uniform bool UseLightOverride <
    string UIName  = "Override Key Light";
    string UIGroup = "3 - Key Light";
    int    UIOrder = 300;
> = false;

uniform vec3 LightDirOverride <
    string UIName   = "Key Light Direction";
    string UIGroup  = "3 - Key Light";
    int    UIOrder  = 301;
> = {-0.4, 0.6, 0.7};

uniform float KeyLightIndex <
