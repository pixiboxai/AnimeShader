    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 2.0; float UIStep = 1.0;
    string UIGroup  = "3 - Key Light";
    int    UIOrder  = 302;
> = 0.0;


//-----------------------------------------------------------------------------
//  ILM / lightmap  (Genshin-style packed mask)
//    R = specular intensity, G = shadow offset / AO, B = specular size, A = material ID
//-----------------------------------------------------------------------------
uniform texture2D LightMap <
    string ResourceName = "";
    string ResourceType = "2D";
    string UIName   = "ILM / Light Map";
    string UIWidget = "FilePicker";
    string UIGroup  = "4 - ILM Mask";
    int    UIOrder  = 400;
>;
uniform sampler2D LightMapSampler = sampler_state {
    Texture = <LightMap>;
    TEXTURE_MIN_FILTER = LINEAR;  TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = REPEAT;      TEXTURE_WRAP_T = REPEAT;
};

uniform bool UseLightMap <
    string UIName  = "Use ILM Map";
    string UIGroup = "4 - ILM Mask";
    int    UIOrder = 401;
> = false;

uniform bool UseMatIDForRamp <
    string UIName  = "Material ID Picks Ramp Row";
    string UIGroup = "4 - ILM Mask";
    int    UIOrder = 402;
> = false;

uniform float ILMAoStrength <
    string UIName   = "ILM AO Strength";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "4 - ILM Mask";
    int    UIOrder  = 403;
> = 1.0;

uniform bool UseVertexAO <
    string UIName  = "AO From Vertex Color G";
    string UIGroup = "4 - ILM Mask";
    int    UIOrder = 404;
> = false;


//-----------------------------------------------------------------------------
//  Specular
//-----------------------------------------------------------------------------
uniform float SpecMode <
    string UIName   = "Spec Mode  0=Off 1=Cel 2=Ramp 3=Hair";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 3.0; float UIStep = 1.0;
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 500;
> = 1.0;

uniform vec3 SpecColor <
    string UIName   = "Specular Color";
    string UIWidget = "ColorPicker";
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 501;
> = {1.0, 1.0, 1.0};

uniform float SpecIntensity <
    string UIName   = "Specular Intensity";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 5.0; float UIStep = 0.05;
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 502;
> = 1.0;

uniform float SpecGloss <
    string UIName   = "Specular Gloss";
    string UIWidget = "Slider";
    float  UIMin = 1.0; float UIMax = 256.0; float UIStep = 1.0;
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 503;
> = 40.0;

uniform float SpecThreshold <
    string UIName   = "Cel Spec Threshold";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 504;
> = 0.5;

uniform float SpecSoftness <
    string UIName   = "Cel Spec Softness";
    string UIWidget = "Slider";
    float  UIMin = 0.001; float UIMax = 0.5; float UIStep = 0.005;
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 505;
> = 0.02;

// GBFR: tint the highlight through a ramp instead of banding it
uniform texture2D SpecRampMap <
    string ResourceName = "";
    string ResourceType = "2D";
    string UIName   = "Specular Ramp";
    string UIWidget = "FilePicker";
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 506;
>;
uniform sampler2D SpecRampSampler = sampler_state {
    Texture = <SpecRampMap>;
    TEXTURE_MIN_FILTER = LINEAR;  TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = CLAMP_TO_EDGE;  TEXTURE_WRAP_T = CLAMP_TO_EDGE;
};

uniform float SpecRampWidth <
    string UIName   = "Specular Ramp Width";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 507;
> = 0.5;


//-----------------------------------------------------------------------------
//  Hair anisotropic  (Kajiya-Kay, GBFR style)
//-----------------------------------------------------------------------------
uniform texture2D HairMask <
    string ResourceName = "";
    string ResourceType = "2D";
    string UIName   = "Hair Mask  R=shift G=ramp B=AO";
    string UIWidget = "FilePicker";
    string UIGroup  = "6 - Hair";
    int    UIOrder  = 600;
>;
uniform sampler2D HairMaskSampler = sampler_state {
    Texture = <HairMask>;
