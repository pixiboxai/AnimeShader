    float  UIMin = 0.0; float UIMax = 3.0; float UIStep = 1.0;
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 500;
> = 1.0;

uniform vec3 SpecColor <
    string UIName   = "Specular Color";
    string UIWidget = "ColorPicker";
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 501;
> = {1.0, 1.0, 1.0};

uniform float SpecIntensity <
    string UIName   = "Specular Intensity";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 5.0; float UIStep = 0.05;
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 502;
> = 1.0;

uniform float SpecGloss <
    string UIName   = "Specular Gloss";
    string UIWidget = "Slider";
    float  UIMin = 1.0; float UIMax = 256.0; float UIStep = 1.0;
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 503;
> = 40.0;

uniform float SpecThreshold <
    string UIName   = "Cel Spec Threshold";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 504;
> = 0.5;

uniform float SpecSoftness <
    string UIName   = "Cel Spec Softness";
    string UIWidget = "Slider";
    float  UIMin = 0.001; float UIMax = 0.5; float UIStep = 0.005;
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 505;
> = 0.02;

// Tint the highlight per pixel. GBFR does this with a ramp driven by the
// highlight's own strength; a map gives direct control instead -- skin can
// take a warm sheen while metal on the same mesh goes cold and hard.
uniform texture2D SpecColorMap <
    string ResourceName = "";
    string ResourceType = "2D";
    string UIName   = "Highlight Color Map";
    string UIWidget = "FilePicker";
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 520;
>;
uniform sampler2D SpecColorSampler = sampler_state {
    Texture = <SpecColorMap>;
    TEXTURE_MIN_FILTER = LINEAR;  TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = REPEAT;      TEXTURE_WRAP_T = REPEAT;
};

uniform bool UseSpecColorMap <
    string UIName  = "Use Highlight Color Map";
    string UIGroup = "5 - Specular";
    int    UIOrder = 521;
> = false;

uniform float SpecColorMapAmount <
    string UIName   = "Highlight Color Amount";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 522;
> = 1.0;

// Paint where the highlight may land. The ILM red channel already does this
// when an ILM map is in play; this is the standalone version for when it is
// not, or when the highlight wants its own map at its own resolution.
uniform texture2D SpecMaskMap <
    string ResourceName = "";
    string ResourceType = "2D";
    string UIName   = "Highlight Mask";
    string UIWidget = "FilePicker";
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 510;
>;
uniform sampler2D SpecMaskSampler = sampler_state {
    Texture = <SpecMaskMap>;
    TEXTURE_MIN_FILTER = LINEAR;  TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = REPEAT;      TEXTURE_WRAP_T = REPEAT;
};

uniform bool UseSpecMask <
    string UIName  = "Use Highlight Mask";
    string UIGroup = "5 - Specular";
    int    UIOrder = 511;
> = false;

uniform float SpecMaskChannel <
    string UIName   = "Highlight Mask Channel  0=R 1=G 2=B 3=A";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 3.0; float UIStep = 1.0;
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 512;
> = 0.0;

uniform bool SpecMaskInvert <
    string UIName  = "Invert Highlight Mask";
    string UIGroup = "5 - Specular";
    int    UIOrder = 513;
> = false;

// GBFR: tint the highlight through a ramp instead of banding it
uniform texture2D SpecRampMap <
    string ResourceName = "";
    string ResourceType = "2D";
    string UIName   = "Specular Ramp";
    string UIWidget = "FilePicker";
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 506;
>;
uniform sampler2D SpecRampSampler = sampler_state {
    Texture = <SpecRampMap>;
    TEXTURE_MIN_FILTER = LINEAR;  TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = CLAMP_TO_EDGE;  TEXTURE_WRAP_T = CLAMP_TO_EDGE;
};

uniform float SpecRampWidth <
    string UIName   = "Specular Ramp Width";
    string UIWidget = "Slider";
    float  UIMin = 0.0; float UIMax = 1.0; float UIStep = 0.01;
    string UIGroup  = "5 - Specular";
    int    UIOrder  = 507;
> = 0.5;


//-----------------------------------------------------------------------------
//  Hair anisotropic  (Kajiya-Kay, GBFR style)
//-----------------------------------------------------------------------------
uniform texture2D HairMask <
    string ResourceName = "";
    string ResourceType = "2D";
    string UIName   = "Hair Mask  R=shift G=ramp B=AO";
    string UIWidget = "FilePicker";
    string UIGroup  = "6 - Hair";
    int    UIOrder  = 600;
>;
uniform sampler2D HairMaskSampler = sampler_state {
    Texture = <HairMask>;
    TEXTURE_MIN_FILTER = LINEAR;  TEXTURE_MAG_FILTER = LINEAR;
