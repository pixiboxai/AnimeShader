// GBFR: triplanar noise breaks the line up so it reads as a drawn stroke
uniform texture2D OutlineNoiseMap <
    string ResourceName = "";
    string ResourceType = "2D";
    string UIName   = "Outline Noise Map";
    string UIWidget = "FilePicker";
    string UIGroup  = "11 - Outline";
    int    UIOrder  = 1109;
>;
